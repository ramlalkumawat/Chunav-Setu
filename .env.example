# ==========================================
# CHUNAV SETU - ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase URL & Public Anon Key
# Provide these from your Supabase project settings -> API.
# If left blank, the app will run with the persistent local engine.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (Server-only for Super Admin elevated ops)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
